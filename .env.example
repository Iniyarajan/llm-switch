# Copy this file to .env and fill in the keys you have.
# You do NOT need all of them. Start with OpenRouter.

# --- Cloud: open-weight + frontier models behind one API ---
# Get from https://openrouter.ai/keys  (add a few $ of credit first)
OPENROUTER_API_KEY=

# --- Optional: fastest open-model inference (great for latency-sensitive agents) ---
# Get from https://console.groq.com/keys  (free tier available)
GROQ_API_KEY=

# --- Optional: direct Claude, if you want to call it without OpenRouter ---
ANTHROPIC_API_KEY=

# Local Ollama needs no key. This is its default.
OLLAMA_BASE_URL=http://localhost:11434/v1
